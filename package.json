{
  "name": "aniversario-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=12.0.0",
    "npm": ">=6.0.0"
  },
  "devDependencies": {
    "react-native-scripts": "2.0.1",
    "jest-expo": "~39.0.0",
    "react-test-renderer": "16.13.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "prettier": "^3.2.0",
    "flow-bin": "^0.45.0"
  },
  "main": "./node_modules/react-native-scripts/build/bin/crna-entry.js",
  "scripts": {
    "start": "react-native-scripts start",
    "eject": "react-native-scripts eject",
    "android": "react-native-scripts android",
    "ios": "react-native-scripts ios",
    "test": "node node_modules/jest/bin/jest.js --watch",
    "test:ci": "node node_modules/jest/bin/jest.js --ci --coverage --watchAll=false",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,md}\"",
    "flow": "flow",
    "build:ci": "npx react-native bundle --platform android --entry-file ./node_modules/react-native-scripts/build/bin/crna-entry.js --bundle-output ./dist/aniversario-bundle.js --dev false",
    "audit": "npm audit --audit-level=high",
    "outdated": "npm outdated",
    "postinstall": "npm audit --audit-level=high || true"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "App.js",
      "!**/node_modules/**",
      "!**/coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "dependencies": {
    "expo": "^39.0.0",
    "react": "16.13.1",
    "react-native": "^0.63.4"
  }
}